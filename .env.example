# Required for any call that reaches Comfy Cloud. Create one at cloud.comfy.org → Settings → API keys.
COMFY_CLOUD_API_KEY=

# Optional. Defaults to https://cloud.comfy.org
COMFY_CLOUD_BASE_URL=

# Optional. When true, submit_workflow validates and cost-checks but never submits.
COMFY_DRY_RUN=false
